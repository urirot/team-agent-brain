{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 /path/to/brain/tools/brain.py hook session-start --cursor",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "python3 /path/to/brain/tools/brain.py hook file --cursor",
        "matcher": "Read|Write",
        "timeout": 10
      }
    ]
  }
}
